s%5Bbot%5D/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions\",\"organizations_url\":\"https://api.github.com/users/github-actions%5Bbot%5D/orgs\",\"repos_url\":\"https://api.github.com/users/github-actions%5Bbot%5D/repos\",\"events_url\":\"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/github-actions%5Bbot%5D/received_events\",\"type\":\"Bot\",\"user_view_type\":\"public\",\"site_admin\":false},\"content_type\":\"application/x-msdownload\",\"state\":\"uploaded\",\"size\":11756032,\"digest\":\"sha256:4bba9d6695f1fa7d6692f9fdf5e9ec272e8d68118fd5d095e9309e6c862436ee\",\"download_count\":39,\"created_at\":\"2026-09-14T00:12:29Z\",\"updated_at\":\"2026-09-14T00:12:29Z\",\"browser_download_url\":\"https://github.com/Maxi0fc/Mira-NotePad/releases/download/v1.4.3/NotePadMod.dll\"}],\"tarball_url\":\"https://api.github.com/repos/Maxi0fc/Mira-NotePad/tarball/v1.4.3\",\"zipball_url\":\"https://api.github.com/repos/Maxi0fc/Mira-NotePad/zipball/v1.4.3\",\"body\":\"# NotePad Mod - Changelog\\r\\n\\r\\n## v1.4.3\\r\\n\\r\\n### New Features\\r\\n- Added Scale Sizing to the notepad and other related things. _See in the LocalSettings for it_\\r\\n\\r\\n### Bug Fixes\\r\\n - Fix Jotted Labels persisting between rounds and games\\r\\n - Fix Prosecute Button being usable after voting.\\r\\n\"}","cachedLatestVersion":"v1.4.3","lastChecked":"2026-09-26T00:02:54.3658645Z"}}}