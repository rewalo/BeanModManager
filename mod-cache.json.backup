r_download_url\":\"https://github.com/DigiWorm0/LevelImposter/releases/download/v1.0.2/LevelImposter.dll\"},{\"url\":\"https://api.github.com/repos/DigiWorm0/LevelImposter/releases/assets/521803813\",\"id\":521803813,\"node_id\":\"RA_kwDOFQG5CM4fGhgl\",\"name\":\"LevelImposter.zip\",\"label\":null,\"uploader\":{\"login\":\"DigiWorm0\",\"id\":10067568,\"node_id\":\"MDQ6VXNlcjEwMDY3NTY4\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/10067568?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/DigiWorm0\",\"html_url\":\"https://github.com/DigiWorm0\",\"followers_url\":\"https://api.github.com/users/DigiWorm0/followers\",\"following_url\":\"https://api.github.com/users/DigiWorm0/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/DigiWorm0/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/DigiWorm0/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/DigiWorm0/subscriptions\",\"organizations_url\":\"https://api.github.com/users/DigiWorm0/orgs\",\"repos_url\":\"https://api.github.com/users/DigiWorm0/repos\",\"events_url\":\"https://api.github.com/users/DigiWorm0/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/DigiWorm0/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"content_type\":\"application/x-zip-compressed\",\"state\":\"uploaded\",\"size\":33106243,\"digest\":\"sha256:ec0f263f63048a697c718860b96c292f8c77ff91c7505e046de25d5bf0a72d6a\",\"download_count\":879,\"created_at\":\"2026-08-20T05:25:17Z\",\"updated_at\":\"2026-08-20T05:25:30Z\",\"browser_download_url\":\"https://github.com/DigiWorm0/LevelImposter/releases/download/v1.0.2/LevelImposter.zip\"}],\"tarball_url\":\"https://api.github.com/repos/DigiWorm0/LevelImposter/tarball/v1.0.2\",\"zipball_url\":\"https://api.github.com/repos/DigiWorm0/LevelImposter/zipball/v1.0.2\",\"body\":\"### Made for **Among Us v18**\\r\\n\\r\\n## Installation\\r\\n1. Download the **LevelImposter.zip** from the Assets below\\r\\n2. Open your Among Us folder\\r\\n\\r\\n- **Steam:** `C:\\\\Program Files (x86)\\\\Steam\\\\steamapps\\\\common\\\\Among Us`\\r\\n- **Epic:** `C:\\\\Program Files\\\\Epic Games\\\\AmongUs\\\\`\\r\\n\\r\\n3. Extract the contents of **LevelImposter.zip** such that `BepInEx`, `dotnet`, and `Among Us_Data` are all in the same Among Us folder\\r\\n4. Launch the game *(Might take a few minutes for the first time)*\\r\\n\\r\\n## Changelog\\r\\n- Added GIF performance optimizations\\r\\n- Added interface for 3rd-party mod support\\r\\n- Added UI to change \\\"Remix Of\\\" in the editor when publishing a map\\r\\n- Added Japanese translation (thanks to @ykundesu)\\r\\n- Fixed Ambient Sounds not producing audio\\r\\n- Fixed bugs w/ HnS mode\\r\\n- Fixed minigame sprite exceptions\\r\\n- Fixed deprecated `util-scroll` on lobby maps\\r\\n- Updated to Among Us v18\\r\\n\\r\\n\u003csub\u003e[AU=2026.8.18]\u003c/sub\u003e\",\"mentions_count\":1}","cachedLatestVersion":"v1.0.2","lastChecked":"2026-09-25T23:56:33.2170951Z"},"yanplaRoles":{"cachedETag":"W/\"e59b9527ac4fd36ee565121925685abdd1503321a55fd394a01a04eb6220078e\"","cachedReleaseData":"{\"url\":\"https://api.github.com/repos/yanpla/yanplaRoles/releases/249705346\",\"assets_url\":\"https://api.github.com/repos/yanpla/yanplaRoles/releases/249705346/assets\",\"upload_url\":\"https://uploads.github.com/repos/yanpla/yanplaRoles/releases/249705346/assets{?name,label}\",\"html_url\":\"https://github.com/yanpla/yanplaRoles/releases/tag/0.2.1\",\"id\":249705346,\"author\":{\"login\":\"yanpla\",\"id\":42470642,\"node_id\":\"MDQ6VXNlcjQyNDcwNjQy\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/42470642?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/yanpla\",\"html_url\":\"https://github.com/yanpla\",\"followers_url\":\"https://api.github.com/users/yanpla/followers\",\"following_url\":\"https://api.github.com/users/yanpla/following{/other_user}\",\"gists_url\":\"http