ets/231828028\",\"id\":231828028,\"node_id\":\"RA_kwDOFJWy6c4N0Wo8\",\"name\":\"TheOtherRoles.zip\",\"label\":null,\"uploader\":{\"login\":\"gendelo3\",\"id\":29977982,\"node_id\":\"MDQ6VXNlcjI5OTc3OTgy\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/29977982?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/gendelo3\",\"html_url\":\"https://github.com/gendelo3\",\"followers_url\":\"https://api.github.com/users/gendelo3/followers\",\"following_url\":\"https://api.github.com/users/gendelo3/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/gendelo3/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/gendelo3/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/gendelo3/subscriptions\",\"organizations_url\":\"https://api.github.com/users/gendelo3/orgs\",\"repos_url\":\"https://api.github.com/users/gendelo3/repos\",\"events_url\":\"https://api.github.com/users/gendelo3/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/gendelo3/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"content_type\":\"application/x-zip-compressed\",\"state\":\"uploaded\",\"size\":39686642,\"digest\":null,\"download_count\":125953,\"created_at\":\"2025-02-23T14:48:15Z\",\"updated_at\":\"2025-02-23T14:48:25Z\",\"browser_download_url\":\"https://github.com/TheOtherRolesAU/TheOtherRoles/releases/download/v4.8.0/TheOtherRoles.zip\"},{\"url\":\"https://api.github.com/repos/TheOtherRolesAU/TheOtherRoles/releases/assets/231828307\",\"id\":231828307,\"node_id\":\"RA_kwDOFJWy6c4N0WtT\",\"name\":\"TheOtherRoles_MSStore.zip\",\"label\":null,\"uploader\":{\"login\":\"gendelo3\",\"id\":29977982,\"node_id\":\"MDQ6VXNlcjI5OTc3OTgy\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/29977982?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/gendelo3\",\"html_url\":\"https://github.com/gendelo3\",\"followers_url\":\"https://api.github.com/users/gendelo3/followers\",\"following_url\":\"https://api.github.com/users/gendelo3/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/gendelo3/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/gendelo3/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/gendelo3/subscriptions\",\"organizations_url\":\"https://api.github.com/users/gendelo3/orgs\",\"repos_url\":\"https://api.github.com/users/gendelo3/repos\",\"events_url\":\"https://api.github.com/users/gendelo3/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/gendelo3/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"content_type\":\"application/x-zip-compressed\",\"state\":\"uploaded\",\"size\":42517229,\"digest\":null,\"download_count\":8641,\"created_at\":\"2025-02-23T14:51:30Z\",\"updated_at\":\"2025-02-23T14:51:41Z\",\"browser_download_url\":\"https://github.com/TheOtherRolesAU/TheOtherRoles/releases/download/v4.8.0/TheOtherRoles_MSStore.zip\"}],\"tarball_url\":\"https://api.github.com/repos/TheOtherRolesAU/TheOtherRoles/tarball/v4.8.0\",\"zipball_url\":\"https://api.github.com/repos/TheOtherRolesAU/TheOtherRoles/zipball/v4.8.0\",\"body\":\"Version 4.8.0\\r\\n\\r\\n- Added an optional Role Draft mode, where players can select their role out of some roles that are shown to them.\\r\\n- Added a new option to allow the medic to shift the medic shield as well - no more invincible medics.\\r\\n- Added partial key rebinding - all kill buttons will now use the vanilla kill button shortcut, same for vent and each role\u0027s first ability.\\r\\n- Fixed the options view panel to match vanilla changes\\r\\n- Fixed options not showing/hiding sub-options when switching Presets\\r\\n- Fixed a bug where voting the witch would not save the target\\r\\n- Fixed some bugs with the trapper, bomber and portal\\r\\n- Fixed a bug in PropHunt where players could not transform into props\\r\\n- Fixed the summary button for the last game appearing outside the lobby sometimes\\r\\n- Changed the positioning of the ping tracker in meetings\",\"reactions\":{\"url\":\"https://api.github.com/repos/TheOtherRolesAU/TheOtherRoles/releases/201906822/reactions\",\"total_count\":51,\"+1\":9,\"-1\":0,\"laugh\":4,\"hooray\":2,\"confused\":0,\"heart\":28,\"rocket\":4,\"eyes\":4}}","cachedLatestVersion":"v4.8.0","lastChecked":"2026-09-25T23:56:17.8443242Z"},"AllTheRoles":{"cachedETag":"W/\"920e8952ed2187cf0221aec6d81a3c72962e3ade56b736a571c20f792d798d32\"","cachedReleaseData":"{\"url\":\"https://api.github.com/repos/Zeo666/AllTheRoles/releases/337962966\",\"assets_url\":\"https://api.github.com/repos/Zeo666/AllTheRoles/releases/337962966/assets\",\"upload_url\":\"https://uploads.github.com/repos/Zeo666/AllTheRoles/releases/337962966/assets{?name,label}\",\"html_url\":\"https://github.com/Zeo666/AllTheRoles/releases/tag/0.14.1\",\"id\":337962966,\"author\":{\"login\":\"Zeo666\",\"id\":14939861,\"node_id\":\"MDQ6VXNlcjE0OTM5ODYx\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/14939861?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/Zeo666\",\"html_url\":\"https://github.com/Zeo666\",\"followers_url\":\"https://api.github.com/users/Zeo666/followers\",\"following_url\":\"https://api.github.com/users/Zeo666/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/Zeo666/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/Zeo666/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/Zeo666/subscriptions\",\"organizations_url\":\"https://api.github.com/users/Zeo666/orgs\",\"repos_url\":\"https://api.github.com/users/Zeo666/repos\",\"events_url\":\"https://api.github.com/users/Zeo666/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/Zeo666/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"node_id\":\"RE_kwDOH67iyM4UJOfW\",\"tag_name\":\"0.14.1\",\"target_commiti