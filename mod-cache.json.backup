te\":\"uploaded\",\"size\":46980323,\"digest\":\"sha256:a70fe305a8ff6cad3d0b1bee4d92c315221c1ddf54e8f8a83188597b7c8bd619\",\"download_count\":1162,\"created_at\":\"2026-09-07T02:48:49Z\",\"updated_at\":\"2026-09-07T02:49:08Z\",\"browser_download_url\":\"https://github.com/SuperNewRoles/SuperNewRoles/releases/download/3.2.0.3a/SuperNewRoles-v3.2.0.3a_Steam.zip\"},{\"url\":\"https://api.github.com/repos/SuperNewRoles/SuperNewRoles/releases/assets/548044265\",\"id\":548044265,\"node_id\":\"RA_kwDOGrpy6M4gqn3p\",\"name\":\"SuperNewRoles.dll\",\"label\":\"\",\"uploader\":{\"login\":\"ykundesu\",\"id\":49261069,\"node_id\":\"MDQ6VXNlcjQ5MjYxMDY5\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/49261069?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/ykundesu\",\"html_url\":\"https://github.com/ykundesu\",\"followers_url\":\"https://api.github.com/users/ykundesu/followers\",\"following_url\":\"https://api.github.com/users/ykundesu/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/ykundesu/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/ykundesu/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/ykundesu/subscriptions\",\"organizations_url\":\"https://api.github.com/users/ykundesu/orgs\",\"repos_url\":\"https://api.github.com/users/ykundesu/repos\",\"events_url\":\"https://api.github.com/users/ykundesu/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/ykundesu/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"content_type\":\"application/octet-stream\",\"state\":\"uploaded\",\"size\":18718720,\"digest\":\"sha256:59d03d78da167e46dbf58b14189da515d501cfbba3d125577933bc1dfb1dc004\",\"download_count\":93,\"created_at\":\"2026-09-07T02:48:40Z\",\"updated_at\":\"2026-09-07T02:48:47Z\",\"browser_download_url\":\"https://github.com/SuperNewRoles/SuperNewRoles/releases/download/3.2.0.3a/SuperNewRoles.dll\"}],\"tarball_url\":\"https://api.github.com/repos/SuperNewRoles/SuperNewRoles/tarball/3.2.0.3a\",\"zipball_url\":\"https://api.github.com/repos/SuperNewRoles/SuperNewRoles/zipball/3.2.0.3a\",\"body\":\"![日本語アナウンス](https://cdn-announcement.supernewroles.com/announcement-images/bd22947f-e79b-42b3-8053-a311a35739e6.webp)\\n\\n![English announcement](https://cdn-announcement.supernewroles.com/announcement-images/82f4e3e4-3ed2-4d3b-b2f2-8b7a5ac6b242.webp)\\n\\n## 新機能\\n- SNRサーバーの部屋検索画面に公開ルームの満員・開始中件数を表示するようになりました。\\n  - 参加できる公開ルームがないときだけ、部屋作成のプロンプトとボタンが表示されます。\\n- 言語設定とサーバーが一致しない場合は、適切なSNRリージョンへの切り替えを案内するようになりました。\\n\\n## パフォーマンス改善\\n- 起動時間を短縮しました。\\n- ゲーム中の一部の処理を改善して高速化しました。\\n\\n## バグ修正\\n- 排他設定の最大数が0のグループに含まれる役職が、最初の抽選で選出されることがある問題を修正しました。\\n- 化け狸・ドッペルゲンガーで変身対象を選択した後に操作不能になる不具合を修正しました。\\n\\n---\\n\\n## New Features\\n- The room search screen on the SNR server now displays the number of full and in-progress public rooms.\\n  - The room creation prompt and button will now only appear when there are no joinable public rooms.\\n- If your language settings do not match the server, the app will now prompt you to switch to the appropriate SNR region.\\n\\n## Performance Improvements\\n- Reduced startup time.\\n- Improved and sped up certain processes during gameplay.\\n\\n## Bug Fixes\\n- Fixed an issue where roles included in a group with a maximum exclusion setting of 0 could sometimes be selected in the initial draw.\\n- Fixed a bug where controls became unresponsive after selecting a transformation target as Bake-danuki or Doppelganger.\"}","cachedLatestVersion":"3.2.0.3a","lastChecked":"2026-09-26T00:02:43.0833709Z"},"Nebula":{"cachedETag":"W/\"eb2225596e5fbfa5f1a4a3dfd1828ad61ccc67db993d67c13c90ad5c757db209\"","cachedReleaseData":"{\"url\":\"https://api.github.com/repos/Dolly1016/Nebula/releases/395868463\",\"assets_url\":\"https://api.github.com/repos/Dolly1016/Nebula/releases/395868463/assets\",\"upload_url\":\"https://uploads.github.com/repos/Dolly1016/Nebula/releases/395868463/assets{?name