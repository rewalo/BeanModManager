53/PropHunt/pull/9\\r\\n\\r\\nNow compatible with v17.2.01!\\r\\n\\r\\nYou can now press \u003ckbd\u003eC\u003c/kbd\u003e to remove your prop and run around!\\r\\n\\r\\n\\r\\n## New Contributors\\r\\n* @superidol1890 made their first contribution in https://github.com/ugackMiner53/PropHunt/pull/9\\r\\n\\r\\n\",\"reactions\":{\"url\":\"https://api.github.com/repos/ugackMiner53/PropHunt/releases/289290040/reactions\",\"total_count\":1,\"+1\":0,\"-1\":0,\"laugh\":0,\"hooray\":1,\"confused\":0,\"heart\":0,\"rocket\":0,\"eyes\":0},\"mentions_count\":1}","cachedLatestVersion":"v2026.2.23","lastChecked":"2026-09-25T23:56:32.0395952Z"},"LevelImposter":{"cachedETag":"W/\"d06f15638b8c4bcfdf14b2086ebf42ecf5d1b21afe8fd21fd1e2aad07922f689\"","cachedReleaseData":"{\"url\":\"https://api.github.com/repos/DigiWorm0/LevelImposter/releases/373505744\",\"assets_url\":\"https://api.github.com/repos/DigiWorm0/LevelImposter/releases/373505744/assets\",\"upload_url\":\"https://uploads.github.com/repos/DigiWorm0/LevelImposter/releases/373505744/assets{?name,label}\",\"html_url\":\"https://github.com/DigiWorm0/LevelImposter/releases/tag/v1.0.2\",\"id\":373505744,\"author\":{\"login\":\"DigiWorm0\",\"id\":10067568,\"node_id\":\"MDQ6VXNlcjEwMDY3NTY4\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/10067568?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/DigiWorm0\",\"html_url\":\"https://github.com/DigiWorm0\",\"followers_url\":\"https://api.github.com/users/DigiWorm0/followers\",\"following_url\":\"https://api.github.com/users/DigiWorm0/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/DigiWorm0/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/DigiWorm0/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/DigiWorm0/subscriptions\",\"organizations_url\":\"https://api.github.com/users/DigiWorm0/orgs\",\"repos_url\":\"https://api.github.com/users/DigiWorm0/repos\",\"events_url\":\"https://api.github.com/user