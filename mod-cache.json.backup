"https://api.github.com/users/OhMyGuus/subscriptions\",\"organizations_url\":\"https://api.github.com/users/OhMyGuus/orgs\",\"repos_url\":\"https://api.github.com/users/OhMyGuus/repos\",\"events_url\":\"https://api.github.com/users/OhMyGuus/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/OhMyGuus/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"content_type\":\"application/octet-stream\",\"state\":\"uploaded\",\"size\":208654032,\"digest\":\"sha256:c9cec94af1e8a359c40dc4dcf3b1124083c77293f5486d992d59bddcb038eb16\",\"download_count\":23319,\"created_at\":\"2026-09-08T21:48:09Z\",\"updated_at\":\"2026-09-08T21:48:14Z\",\"browser_download_url\":\"https://github.com/OhMyGuus/BetterCrewLink/releases/download/v3.2.2/Better-CrewLink-Setup-3.2.2.exe\"},{\"url\":\"https://api.github.com/repos/OhMyGuus/BetterCrewLink/releases/assets/551381444\",\"id\":551381444,\"node_id\":\"RA_kwDOEwsXhs4g3WnE\",\"name\":\"Better-CrewLink-Setup-3.2.2.exe.blockmap\",\"label\":\"\",\"uploader\":{\"login\":\"OhMyGuus\",\"id\":12090928,\"node_id\":\"MDQ6VXNlcjEyMDkwOTI4\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/12090928?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/OhMyGuus\",\"html_url\":\"https://github.com/OhMyGuus\",\"followers_url\":\"https://api.github.com/users/OhMyGuus/followers\",\"following_url\":\"https://api.github.com/users/OhMyGuus/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/OhMyGuus/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/OhMyGuus/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/OhMyGuus/subscriptions\",\"organizations_url\":\"https://api.github.com/users/OhMyGuus/orgs\",\"repos_url\":\"https://api.github.com/users/OhMyGuus/repos\",\"events_url\":\"https://api.github.com/users/OhMyGuus/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/OhMyGuus/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"content_type\":\"application/octet-stream\",\"state\":\"uploaded\",\"size\":215496,\"digest\":\"sha256:fe848b93a394ad3a2e995d0084efe2c2921cf22448b9437faeaeb6b92a7d1845\",\"download_count\":9320,\"created_at\":\"2026-09-08T21:48:09Z\",\"updated_at\":\"2026-09-08T21:48:09Z\",\"browser_download_url\":\"https://github.com/OhMyGuus/BetterCrewLink/releases/download/v3.2.2/Better-CrewLink-Setup-3.2.2.exe.blockmap\"},{\"url\":\"https://api.github.com/repos/OhMyGuus/BetterCrewLink/releases/assets/551370486\",\"id\":551370486,\"node_id\":\"RA_kwDOEwsXhs4g3T72\",\"name\":\"latest-linux.yml\",\"label\":\"\",\"uploader\":{\"login\":\"OhMyGuus\",\"id\":12090928,\"node_id\":\"MDQ6VXNlcjEyMDkwOTI4\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/12090928?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/OhMyGuus\",\"html_url\":\"https://github.com/OhMyGuus\",\"followers_url\":\"https://api.github.com/users/OhMyGuus/followers\",\"following_url\":\"https://api.github.com/users/OhMyGuus/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/OhMyGuus/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/OhMyGuus/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/OhMyGuus/subscriptions\",\"organizations_url\":\"https://api.github.com/users/OhMyGuus/orgs\",\"repos_url\":\"https://api.github.com/users/OhMyGuus/repos\",\"events_url\":\"https://api.github.com/users/OhMyGuus/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/OhMyGuus/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"content_type\":\"text/yaml\",\"state\":\"uploaded\",\"size\":382,\"digest\":\"sha256:3bfc31d20d25821c178009525a87c4714a4856a3c08eed134a3d3fbdbd0f6ca5\",\"download_count\":474,\"created_at\":\"2026-09-08T21:42:29Z\",\"updated_at\":\"2026-09-08T21:42:29Z\",\"browser_download_url\":\"https://github.com/OhMyGuus/BetterCrewLink/releases/download/v3.2.2/latest-linux.yml\"},{\"url\":\"https://api.github.com/repos/OhMyGuus/BetterCrewLink/releases/assets/551381567\",\"id\":551381567,\"node_id\":\"RA_kwDOEwsXhs4g3Wo_\",\"name\":\"latest.yml\",\"label\":\"\",\"uploader\":{\"login\":\"OhMyGuus\",\"id\":12090928,\"node_id\":\"MDQ6VXNlcjEyMDkwOTI4\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/12090928?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/OhMyGuus\",\"html_url\":\"https://github.com/OhMyGuus\",\"followers_url\":\"https://api.github.com/users/OhMyGuus/followers\",\"following_url\":\"https://api.github.com/users/OhMyGuus/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/OhMyGuus/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/OhMyGuus/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/OhMyGuus/subscriptions\",\"organizations_url\":\"https://api.github.com/users/OhMyGuus/orgs\",\"repos_url\":\"https://api.github.com/users/OhMyGuus/repos\",\"events_url\":\"https://api.github.com/users/OhMyGuus/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/OhMyGuus/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"content_type\":\"text/yaml\",\"state\":\"uploaded\",\"size\":359,\"digest\":\"sha256:b8279e8553a7d1f4b95173dfd59a34c23fcfb8e1527a9f9d044c42197678b1c3\",\"download_count\":41103,\"created_at\":\"2026-09-08T21:48:14Z\",\"updated_at\":\"2026-09-08T21:48:14Z\",\"browser_download_url\":\"https://github.com/OhMyGuus/BetterCrewLink/releases/download/v3.2.2/latest.yml\"}],\"tarball_url\":\"https://api.github.com/repos/OhMyGuus/BetterCrewLink/tarball/v3.2.2\",\"zipball_url\":\"https://api.github.com/repos/OhMyGuus/BetterCrewLink/zipball/v3.2.2\",\"body\":\"# Version: v3.2.2\\r\\n\\r\\n## Downloads\\r\\n\\r\\n* [Download from GitHub](https://github.com/OhMyGuus/BetterCrewLink/releases/download/v3.2.2/Better-CrewLink-Setup-3.2.2.exe)\\r\\n\\r\\n\\r\\n## FAQ\\r\\n\\r\\n- What voice server do you recommend? **-\u003e** I recommend the voice server \u003ca href=\\\"https://bettercrewl.ink\\\"\u003e`https://bettercrewl.ink`\u003c/a\u003e for the best support. (fixes NAT issues)\\r\\n- My NAT is strict how can I play? **-\u003e** Enable NAT FIX in the settings.\\r\\n- Is there a Discord for support? **-\u003e** Yes you can join, https://discord.gg/ctVu4fw9qR\\r\\n- How to use the mobile version? **-\u003e** Read info here: [Better-Crewlink mobile](https://github.com/OhMyGuus/BetterCrewlink-mobile/releases/latest)\\r\\n- Is there a Mirror? **-\u003e** Yes you can find it here: [BetterCrewlink Mirror](https://mirror.bettercrewl.ink/)\\r\\n- How to setup the OBS Overlay? **-\u003e** https://i.imgur.com/zjvevBu.png\\r\\n\\r\\nFor more questions/help you can join our Discord server:\\r\\n\\r\\n\u003cdiv\u003e\\r\\n  \u003ca target=\\\"_blank\\\" href=\\\"https://discord.gg/qDqTzvj4SH\\\" title=\\\"Join our Discord!\\\"\u003e\\r\\n    \u003cimg height=\\\"75px\\\" draggable=\\\"false\\\" src=\\\"https://discordapp.com/api/guilds/791516611143270410/widget.png?style=banner2\\\" alt=\\\"Join our Discord!\\\"\u003e\\r\\n  \u003c/a\u003e\\r\\n\u003c/div\u003e\\r\\n\\r\\n## Changes Logs\\r\\n### 3.2.2\\r\\n* **Microphone switching now actually works Sorry!**\\r\\n* Fungle doors now block audio \\r\\n* Fixed a couple of bugs\\r\\n* Added another lobby setting for muted lobbies\\r\\n\\r\\n### 3.2.1\\r\\n* Fixed mobile version comtability\\r\\n* Added private impostor radio (BE AWARE NOT WORKING ON WEB/MOBILE YET!)\\r\\n* Added some fixed\\r\\n* Added way to test microphone\\r\\n* Added auto gain control (beta)\\r\\n\\r\\n### 3.2.0\\r\\n* New settings window, we hope you like it 🙂\\r\\n* Refactored things so mobile will be more stable soon\\r\\n* Security fixes\\r\\n* Voice fixes, refactor, it should now be less laggy on bigger lobbies\\r\\n* Fixed shapeshifter bug in meetings. \\r\\n\\r\\n### 3.1.4\\r\\n* Add floormap for Fungle map\\r\\n* Add mod support for Town of Us Mira\\r\\n\\r\\n\\r\\n### 3.1.1\\r\\n* Removed submerged floormap\\r\\n* Added initial support for new map\\r\\n* Added fix for longer names due to TMPro tags by @JKohlman in https://github.com/OhMyGuus/BetterCrewLink/pull/359\\r\\n\\r\\n### 3.1.1\\r\\n* Support for new Among us version. \\r\\n\\r\\n### 3.1.0 \\r\\n* Fixed mute button issues by @JKohlman\\r\\n* Finished optimizing all SVG sizes by @JKohlman\\r\\n* Fixed overflowing username box by @JKohlman\\r\\n* Add support to all Crowdin languages by @MatadorProBr \\r\\n* Impostor radio shortcut crashes BCL by @JKohlman\\r\\n* Added a slider to adjust ghost volume for impostors by @JKohlman\\r\\n\\r\\n**If you find a issue please just report on [Discord server](https://discord.gg/qDqTzvj4SH) or [GitHub](https://github.com/OhMyGuus/BetterCrewLink/issues) or DM me on Discord ([ThaGuus#2140](https://discordapp.com/users/508426414387757057)) so we can fix it. If we don\u0027t know the bug we won\u0027t fix it**\\r\\n\\r\\n\u003cdiv\u003e\\r\\n  \u003ca target=\\\"_blank\\\" href=\\\"https://discord.gg/qDqTzvj4SH\\\" title=\\\"Join our Discord!\\\"\u003e\\r\\n    \u003cimg height=\\\"75px\\\" draggable=\\\"false\\\" src=\\\"https://discordapp.com/api/guilds/791516611143270410/widget.png?style=banner2\\\" alt=\\\"Join our Discord!\\\"\u003e\\r\\n  \u003c/a\u003e\\r\\n\u003c/div\u003e\\r\\n\\r\\n## Linux\\r\\nTo install it on Linux go to the installation guide for Linux by [clicking here](https://github.com/OhMyGuus/BetterCrewLink/wiki/Installation#linux).\\r\\n\\r\\n## Notes\\r\\n\\r\\n- This is an unofficial fork of CrewLink, for any problem, question, issue or suggestion you have with **Better**CrewLink talk to us on our [Discord](https://discord.gg/qDqTzvj4SH), [GitHub](https://github.com/OhMyGuus/BetterCrewLink/issues) or message the developer on Discord ([ThaGuus#2140](https://discord.com/users/508426414387757057)), do not report any problems to The official Discord or GitHub of normal and official CrewLink as they will not help you.\\r\\n\\r\\n- We are not affiliated with CrewLink, we are just a modified/better version of the original CrewLink, so if you need help with CrewLink, we will not offer any help for you about CrewLink here, we will only help you if you are using **Better**CrewLink, if you want to download BetterCrewLink look at the [GitHub](https://github.com/OhMyGuus/BetterCrewLink/releases/latest).\\r\\n\\r\\n\u003cdetails\u003e\\r\\n\u003csummary\u003e The original/normal CrewLink is now discontinued and that means the original/normal CrewLink will never be updated and will never work again, so BetterCrewLink is the only way to make your CrewLink works \u003c/summary\u003e\\r\\n\\r\\n![CrewLink has been discontinued](https://user-images.githubusercontent.com/71022656/121688157-84197500-ca99-11eb-869e-6af3b720d2eb.png)\\r\\n\\r\\n\u003c/details\u003e\\r\\n\\r\\n- To get the most of BetterCrewLink use the Voice Server: \u003ca href=\\\"https://bettercrewl.ink\\\"\u003e`https://bettercrewl.ink`\u003c/a\u003e\\r\\n\\r\\n\u003cdiv\u003e\\r\\n\\r\\n## Downloads\\r\\n\\r\\n* [Download from GitHub](https://github.com/OhMyGuus/BetterCrewLink/releases/download/v3.0.3/Better-CrewLink-Setup-3.0.3.exe)\\r\\n\\r\\n\\r\\n## FAQ\\r\\n\\r\\n- What voice server do you recommend? **-\u003e** I recommend the voice server \u003ca href=\\\"https://bettercrewl.ink\\\"\u003e`https://bettercrewl.ink`\u003c/a\u003e for the best support. (fixes NAT issues)\\r\\n- My NAT is strict how can I play? **-\u003e** Enable NAT FIX in the settings.\\r\\n- Is there a Discord for support? **-\u003e** Yes you can join, https://discord.gg/ctVu4fw9qR\\r\\n- How to use the mobile version? **-\u003e** Read info here: [Better-Crewlink mobile](https://github.com/OhMyGuus/BetterCrewlink-mobile/releases/latest)\\r\\n- Is there a Mirror? **-\u003e** Yes you can find it here: [BetterCrewlink Mirror](https://mirror.bettercrewl.ink/)\\r\\n- How to setup the OBS Overlay? **-\u003e** https://i.imgur.com/zjvevBu.png\\r\\n\\r\\nFor more questions/help you can join our Discord server:\\r\\n\\r\\n\u003cdiv\u003e\\r\\n  \u003ca target=\\\"_blank\\\" href=\\\"https://discord.gg/qDqTzvj4SH\\\" title=\\\"Join our Discord!\\\"\u003e\\r\\n    \u003cimg height=\\\"75px\\\" draggable=\\\"false\\\" src=\\\"https://discordapp.com/api/guilds/791516611143270410/widget.png?style=banner2\\\" alt=\\\"Join our Discord!\\\"\u003e\\r\\n  \u003c/a\u003e\\r\\n\u003c/div\u003e\\r\\n\\r\\n**If you find a issue please just report on [Discord server](https://discord.gg/qDqTzvj4SH) or [GitHub](https://github.com/OhMyGuus/BetterCrewLink/issues) or DM me on Discord ([ThaGuus#2140](https://discordapp.com/users/508426414387757057)) so we can fix it. If we don\u0027t know the bug we won\u0027t fix it**\\r\\n\\r\\n\u003cdiv\u003e\\r\\n  \u003ca target=\\\"_blank\\\" href=\\\"https://discord.gg/qDqTzvj4SH\\\" title=\\\"Join our Discord!\\\"\u003e\\r\\n    \u003cimg height=\\\"75px\\\" draggable=\\\"false\\\" src=\\\"https://discordapp.com/api/guilds/791516611143270410/widget.png?style=banner2\\\" alt=\\\"Join our Discord!\\\"\u003e\\r\\n  \u003c/a\u003e\\r\\n\u003c/div\u003e\\r\\n\\r\\n## Linux\\r\\nTo install it on Linux go to the installation guide for Linux by [clicking here](https://github.com/OhMyGuus/BetterCrewLink/wiki/Installation#linux).\\r\\n\\r\\n## Notes\\r\\n\\r\\n- This is an unofficial fork of CrewLink, for any problem, question, issue or suggestion you have with **Better**CrewLink talk to us on our [Discord](https://discord.gg/qDqTzvj4SH), [GitHub](https://github.com/OhMyGuus/BetterCrewLink/issues) or message the developer on Discord ([ThaGuus#2140](https://discord.com/users/508426414387757057)), do not report any problems to The official Discord or GitHub of normal and official CrewLink as they will not help you.\\r\\n\\r\\n- We are not affiliated with CrewLink, we are just a modified/better version of the original CrewLink, so if you need help with CrewLink, we will not offer any help for you about CrewLink here, we will only help you if you are using **Better**CrewLink, if you want to download BetterCrewLink look at the [GitHub](https://github.com/OhMyGuus/BetterCrewLink/releases/latest).\\r\\n\\r\\n\u003cdetails\u003e\\r\\n\u003csummary\u003e The original/normal CrewLink is now discontinued and that means the original/normal CrewLink will never be updated and will never work again, so BetterCrewLink is the only way to make your CrewLink works \u003c/summary\u003e\\r\\n\\r\\n![CrewLink has been discontinued](https://user-images.githubusercontent.com/71022656/121688157-84197500-ca99-11eb-869e-6af3b720d2eb.png)\\r\\n\\r\\n\u003c/details\u003e\\r\\n\\r\\n- To get the most of BetterCrewLink use the Voice Server: \u003ca href=\\\"https://bettercrewl.ink\\\"\u003e`https://bettercrewl.ink`\u003c/a\u003e\\r\\n\\r\\n\u003cdiv\u003e\\r\\n  \u003ca target=\\\"_blank\\\" href=\\\"https://discord.gg/qDqTzvj4SH\\\" title=\\\"Join our Discord!\\\"\u003e\\r\\n    \u003cimg height=\\\"75px\\\" draggable=\\\"false\\\" src=\\\"https://discordapp.com/api/guilds/791516611143270410/widget.png?style=banner2\\\" alt=\\\"Join our Discord!\\\"\u003e\\r\\n  \u003c/a\u003e\\r\\n\u003c/div\u003e\\r\\n\\r\\n#\\r\\n\u003cp align=\\\"center\\\"\u003eThis mod is not affiliated with Among Us or Innersloth LLC, and the content contained therein is not endorsed or otherwise sponsored by Innersloth LLC. Portions of the materials contained herein are property of Innersloth LLC.\u003c/p\u003e\\r\\n\u003cp align=\\\"center\\\"\u003e© Innersloth LLC.\u003c/p\u003e\\r\\n\\r\\n\\r\\n**Full Changelog**: https://github.com/OhMyGuus/BetterCrewLink/compare/v3.2.0...v3.2.1\\r\\n\\r\\n\\r\\n\\r\\n**Full Changelog**: https://github.com/OhMyGuus/BetterCrewLink/compare/v3.2.0...v3.2.1\\r\\n\\r\\n## What\u0027s Changed\\r\\n* Fix selected microphone capture by @OhMyGuus in https://github.com/OhMyGuus/BetterCrewLink/pull/417\\r\\n* Take the two dependency upgrades that hold, and record why the rest do not by @greluc in https://github.com/OhMyGuus/BetterCrewLink/pull/416\\r\\n* Ramp peer gain instead of stepping it, so mutes stop clicking by @greluc in https://github.com/OhMyGuus/BetterCrewLink/pull/412\\r\\n* Ramp the microphone gate closed, so sentences stop ending in a click by @greluc in https://github.com/OhMyGuus/BetterCrewLink/pull/413\\r\\n* Stop a 404 or a rate limit being read as the offsets data by @greluc in https://github.com/OhMyGuus/BetterCrewLink/pull/414\\r\\n* Read Fungle\u0027s doors from the offset that describes them by @greluc in https://github.com/OhMyGuus/BetterCrewLink/pull/410\\r\\n* Stop mute and deafen firing the moment they are assigned by @greluc in https://github.com/OhMyGuus/BetterCrewLink/pull/409\\r\\n* Let ghosts talk during the round, and ease the cut when one starts by @greluc in https://github.com/OhMyGuus/BetterCrewLink/pull/411\\r\\n\\r\\n\\r\\n**Full Changelog**: https://github.com/OhMyGuus/BetterCrewLink/compare/v3.2.1...v3.2.2\",\"discussion_url\":\"https://github.com/OhMyGuus/BetterCrewLink/discussions/418\",\"reactions\":{\"url\":\"https://api.github.com/repos/OhMyGuus/BetterCrewLink/releases/385082252/reactions\",\"total_count\":1,\"+1\":1,\"-1\":0,\"laugh\":0,\"hooray\":0,\"confused\":0,\"heart\":0,\"rocket\":0,\"eyes\":0},\"mentions_count\":4}","cachedLatestVersion":"v3.2.2","lastChecked":"2026-09-26T00:03:39.4763324Z"},"Better-BCL":{"cachedETag":"W/\"3dea99a3475eb3f09217d48835c13fd641ac2662a1e85f40984d93e3880086df\"","cachedReleaseData":"{\"url\":\"https://api.github.com/repos/rewalo/BetterCrewLink/releases/266589140\",\"assets_url\":\"https://api.github.com/repos/rewalo/BetterCrewLink/releases/266589140/assets\",\"upload_url\":\"https://uploads.github.com/repos/rewalo/BetterCrewLink/releases/266589140/assets{?name,label}\",\"html_url\":\"https://github.com/rewalo/BetterCrewLink/releases/tag/v3.1.5\",\"id\":266589140,\"author\":{\"login\":\"rewalo\",\"id\":170283204,\"node_id\":\"U_kgDOCiZQxA\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/170283204?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/rewalo\",\"html_url\":\"https://github.com/rewalo\",\"followers_url\":\"https://api.github.com/users/rewalo/followers\",\"following_url\":\"https://api.github.com/users/rewalo/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/rewalo/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/rewalo/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/rewalo/subscriptions\",\"organizations_url\":\"https://api.github.com/users/rewalo/orgs\",\"repos_url\":\"https://api.github.com/users/rewalo/repos\",\"events_url\":\"https://api.github.com/users/rewalo/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/rewalo/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"node_id\":\"RE_kwDOQgF6qM4P49PU\",\"tag_name\":\"v3.1.5\",\"target_commitish\":\"nightly\",\"name\":\"Better-BCL (v3.1.5)\",\"draft\":false,\"immutable\":false,\"prerelease\":false,\"created_at\":\"2025-08-30T19:18:38Z\",\"updated_at\":\"2025-12-02T04:04:03Z\",\"published_at\":\"2025-12-02T04:02:24Z\",\"assets\":[{\"url\":\"https://api.github.com/repos/rewalo/BetterCrewLink/releases/assets/323211494\",\"id\":323211494,\"node_id\":\"RA_kwDOQgF6qM4TQ9Dm\",\"name\":\"Better-CrewLink-Unpacked-x64.zip\",\"label\":null,\"uploader\":{\"login\":\"rewalo\",\"id\":170283204,\"node_id\":\"U_kgDOCiZQxA\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/170283204?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/rewalo\",\"html_url\":\"https://github.com/rewalo\",\"followers_url\":\"https://api.github.com/users/rewalo/followers\",\"following_url\":\"https://api.github.com/users/rewalo/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/rewalo/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/rewalo/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/rewalo/subscriptions\",\"organizations_url\":\"https://api.github.com/users/rewalo/orgs\",\"repos_url\":\"https://api.github.com/users/rewalo/repos\",\"events_url\":\"https://api.github.com/users/rewalo/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/rewalo/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"content_type\":\"application/x-zip-compressed\",\"state\":\"uploaded\",\"size\":136678173,\"digest\":\"sha256:e3e962453c0459923806b64147267bf524c10cdcc41023c7164ae0b4fe4dd464\",\"download_count\":800,\"created_at\":\"2025-12-02T04:02:18Z\",\"updated_at\":\"2025-12-02T04:02:23Z\",\"browser_download_url\":\"https://github.com/rewalo/BetterCrewLink/releases/download/v3.1.5/Better-CrewLink-Unpacked-x64.zip\"}],\"tarball_url\":\"https://api.github.com/repos/rewalo/BetterCrewLink/tarball/v3.1.5\",\"zipball_url\":\"https://api.github.com/repos/rewalo/BetterCrewLink/zipball/v3.1.5\",\"body\":\"Added two new lobby settings that enhance the \\\"Meetings/Lobby Only\\\" voice mode:\\r\\n\\r\\n### 1. Ghosts can Talk Ingame\\r\\n- **Requirement**: Can only be enabled when \\\"Meetings/Lobby Only\\\" is enabled\\r\\n- **Functionality**:\\r\\n  - Allows ghosts to talk and hear each other during the game (TASKS state)\\r\\n  - Ghosts can hear each other anywhere on the map (distance-independent, like meetings)\\r\\n  - Ghosts can hear alive players during grace period (if enabled)\\r\\n  - In meetings, ghosts can hear both alive players and other ghosts\\r\\n\\r\\n### 2. Grace Period\\r\\n- **Requirement**: Can only be enabled when \\\"Meetings/Lobby Only\\\" is enabled\\r\\n- **Functionality**:\\r\\n  - Customizable delay (0-10 seconds, 0.5s increments) before voices are cut off\\r\\n  - Applies when transitioning from LOBBY -\u003e TASKS, LOBBY -\u003e DISCUSSION, or between TASKS \u003c-\u003e DISCUSSION\\r\\n  - Prevents abrupt voice cutoff when games/meetings start\\r\\n  - Allows both hearing and talking during the grace period\\r\\n\\r\\n_Note: I didn\u0027t add extra translations because I don\u0027t speak the languages. Sorry :C_\",\"reactions\":{\"url\":\"https://api.github.com/repos/rewalo/BetterCrewLink/releases/266589140/reactions\",\"total_count\":2,\"+1\":1,\"-1\":0,\"laugh\":0,\"hooray\":0,\"confused\":0,\"heart\":1,\"rocket\":0,\"eyes\":0}}","cachedLatestVersion":"v3.1.5","lastChecked":"2026-09-25T23:56:16.6311568Z"},"TheOtherRoles":{"cachedETag":"W/\"f7be093099b558d24f03e82c2360138f1e71a76a4fd86f2b1e60139a4c30bc95\"","cachedReleaseData":"{\"url\":\"https://api.github.com/repos/TheOtherRolesAU/TheOtherRoles/releases/201906822\",\"assets_url\":\"https://api.github.com/repos/TheOtherRolesAU/TheOtherRoles/releases/201906822/assets\",\"upload_url\":\"https://uploads.github.com/repos/TheOtherRolesAU/TheOtherRoles/releases/201906822/assets{?name,label}\",\"html_url\":\"https://github.com/TheOtherRolesAU/TheOtherRoles/releases/tag/v4.8.0\",\"id\":201906822,\"author\":{\"login\":\"gendelo3\",\"id\":29977982,\"node_id\":\"MDQ6VXNlcjI5OTc3OTgy\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/29977982?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/gendelo3\",\"html_url\":\"https://github.com/gendelo3\",\"followers_url\":\"https://api.github.com/users/gendelo3/followers\",\"following_url\":\"https://api.github.com/users/gendelo3/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/gendelo3/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/gendelo3/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/gendelo3/subscriptions\",\"organizations_url\":\"https://api.github.com/users/gendelo3/orgs\",\"repos_url\":\"https://api.github.com/users/gendelo3/repos\",\"events_url\":\"https://api.github.com/users/gendelo3/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/gendelo3/received_events\",\"type\":\"Use